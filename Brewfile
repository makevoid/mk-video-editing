# brew bundle — command-line prerequisites for mk-video-editing (macOS 14+, Apple Silicon).
# Swift comes from Xcode or the command line tools: xcode-select --install
brew "ruby"         # 3.2+; the system Ruby is too old. Homebrew Ruby is keg-only: put it first in PATH.
brew "ffmpeg"
brew "imagemagick"
brew "python"
brew "uv"           # ephemeral Python envs for mlx-whisper, Demucs and speech_flow
